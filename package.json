{
  "name": "sand-to-gpu",
  "version": "0.1.0",
  "description": "An interactive course through the semiconductor supply chain, from raw materials to GPU systems.",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DicksonWu654/sand-to-gpu.git"
  },
  "bugs": {
    "url": "https://github.com/DicksonWu654/sand-to-gpu/issues"
  },
  "dependencies": {
    "marked": "^14.1.4",
    "puppeteer": "25.11.0"
  },
  "scripts": {
    "start": "node serve.js",
    "build": "node build.js",
    "check": "node qa/check.js && node course/visuals/render.js --strict && node qa/section-figures.js",
    "qa:widget": "node qa/render.js widget",
    "qa:page": "node qa/render.js page",
    "qa:sweep": "node qa/sweep.js",
    "narration:setup": "node tools/narration/setup.js",
    "narration:setup-gpu": "node tools/narration/setup-gpu.js",
    "narration:inventory": "node tools/narration/inventory.js",
    "narration:prerender": "node tools/narration/prerender.js",
    "narration:export": "node tools/narration/finish-export.js",
    "qa:narration": "node qa/narration.js && node qa/narration-static.js && node qa/narration-paragraph.js",
    "check:markdown": "node qa/page-markdown.js"
  }
}
